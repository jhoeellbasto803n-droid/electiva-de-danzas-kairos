APP_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/electiva_danzas
SESSION_SECRET=REEMPLAZA_ESTO_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
DB_POOL_MAX=30
WEB_THREADS=32

# Asistente academico. Por defecto funciona con reglas locales, sin servicios
# externos. AGENT_MODE=auto usa n8n solo si hay webhook y clave; local fuerza
# las reglas locales; n8n exige ambas variables.
AGENT_MODE=auto
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
# Correos autorizados para el piloto, separados por coma. Vacio = cualquier
# cuenta con sesion iniciada. Ejemplo:
# AGENT_ALLOWED_EMAILS=estudiante1@unicafam.edu.co,estudiante2@unicafam.edu.co
AGENT_ALLOWED_EMAILS=

